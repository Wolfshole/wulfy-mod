---
interface Props {
    id: string;
    placeholder?: string;
}

const { id, placeholder = "Rollen auswählen..." } = Astro.props;
---

<div class="multi-select" data-id={id}>
    <button type="button" class="multi-select-trigger">
        <span class="multi-select-label">{placeholder}</span>
        <span class="multi-select-arrow">▾</span>
    </button>
    <div class="multi-select-dropdown" hidden>
        <div class="multi-select-options"></div>
    </div>
</div>

<style>
    .multi-select {
        position: relative;
        width: 100%;
    }

    .multi-select-trigger {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--bg-input, #0f1320);
        border: 1px solid var(--border, #232838);
        border-radius: 8px;
        padding: 0.65rem 0.85rem;
        color: var(--text, #e8ecf5);
        font-size: 0.9rem;
        cursor: pointer;
        text-align: left;
        transition: border-color 0.15s, box-shadow 0.15s;
    }

    .multi-select-trigger:hover {
        border-color: var(--border-light, #2c3245);
    }

    .multi-select.open .multi-select-trigger {
        border-color: var(--accent, #2563eb);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    .multi-select-label {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--text-muted, #8b93a7);
    }

    .multi-select.has-selection .multi-select-label {
        color: var(--text, #e8ecf5);
    }

    .multi-select-arrow {
        color: var(--text-muted, #8b93a7);
        font-size: 0.8rem;
        transition: transform 0.15s;
        margin-left: 0.5rem;
    }

    .multi-select.open .multi-select-arrow {
        transform: rotate(180deg);
    }

    .multi-select-dropdown {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        background: var(--bg-card, #161a25);
        border: 1px solid var(--border, #232838);
        border-radius: 8px;
        max-height: 220px;
        overflow-y: auto;
        z-index: 100;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    }

    .multi-select-options {
        padding: 0.35rem;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    /* WICHTIG: Optionen als Block-Elemente, damit sie untereinander stehen */
    .multi-select-options :global(.multi-select-option) {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        gap: 0.6rem !important;
        padding: 0.5rem 0.65rem !important;
        border-radius: 6px !important;
        cursor: pointer !important;
        font-size: 0.9rem !important;
        color: var(--text, #e8ecf5) !important;
        transition: background 0.1s !important;
        white-space: nowrap;
    }

    .multi-select-options :global(.multi-select-option:hover) {
        background: var(--bg-hover, #1e2331) !important;
    }

    .multi-select-options :global(.multi-select-option input[type="checkbox"]) {
        width: 16px !important;
        height: 16px !important;
        min-width: 16px !important;
        margin: 0 !important;
        accent-color: var(--accent, #2563eb) !important;
        cursor: pointer !important;
        flex-shrink: 0;
    }

    .multi-select-options :global(.multi-select-option span) {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .multi-select-options :global(.multi-select-empty) {
        padding: 0.75rem;
        text-align: center;
        color: var(--text-muted, #8b93a7);
        font-size: 0.85rem;
    }
</style>

<script>
    document.querySelectorAll('.multi-select').forEach(container => {
        const trigger = container.querySelector('.multi-select-trigger');
        const dropdown = container.querySelector('.multi-select-dropdown');
        const optionsContainer = container.querySelector('.multi-select-options');
        const label = container.querySelector('.multi-select-label');

        trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            document.querySelectorAll('.multi-select.open').forEach(other => {
                if (other !== container) {
                    other.classList.remove('open');
                    other.querySelector('.multi-select-dropdown').hidden = true;
                }
            });
            container.classList.toggle('open');
            dropdown.hidden = !container.classList.contains('open');
        });

        function updateLabel() {
            const selected = Array.from(optionsContainer.querySelectorAll('input:checked'));
            if (selected.length === 0) {
                label.textContent = 'Rollen auswählen...';
                container.classList.remove('has-selection');
            } else if (selected.length === 1) {
                label.textContent = selected[0].dataset.name;
                container.classList.add('has-selection');
            } else {
                label.textContent = `${selected.length} Rollen ausgewählt`;
                container.classList.add('has-selection');
            }
        }

        container.setOptions = (roles) => {
            optionsContainer.innerHTML = '';
            if (roles.length === 0) {
                optionsContainer.innerHTML = '<div class="multi-select-empty">Keine Rollen verfügbar</div>';
                return;
            }
            roles.forEach(role => {
                const opt = document.createElement('label');
                opt.className = 'multi-select-option';
                opt.innerHTML = `
                    <input type="checkbox" value="${role.id}" data-name="@${role.name}" />
                    <span>@${role.name}</span>
                `;
                opt.querySelector('input').addEventListener('change', updateLabel);
                optionsContainer.appendChild(opt);
            });
            updateLabel();
        };

        container.getValues = () => {
            return Array.from(optionsContainer.querySelectorAll('input:checked')).map(i => i.value);
        };

        container.setValues = (values) => {
            optionsContainer.querySelectorAll('input').forEach(input => {
                input.checked = values.includes(input.value);
            });
            updateLabel();
        };
    });

    document.addEventListener('click', () => {
        document.querySelectorAll('.multi-select.open').forEach(c => {
            c.classList.remove('open');
            c.querySelector('.multi-select-dropdown').hidden = true;
        });
    });
</script>