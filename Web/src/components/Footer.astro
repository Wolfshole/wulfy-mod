---
import Logo from "./Logo.astro";

interface Props {
    variant?: "landing" | "dashboard";
}

const { variant = "landing" } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={["footer", variant]}>
    <div class="content">
        <div class="brand">
            <Logo size={28} showText={false} />
            <span>Wulf Mod Bot</span>
        </div>

        <ul class="links">
            <li><a href="/impressum">Impressum</a></li>
            <li><a href="/datenschutz">Datenschutz</a></li>
            <li><a href="/docs">Dokumentation</a></li>
        </ul>

        <p class="copyright">© {year} Wulf Mod Bot</p>
    </div>
</footer>

<style>
    .footer {
        border-top: 1px solid var(--border);
        color: var(--text-muted);
        font-size: 0.85rem;
        margin-top: 4rem;
    }

    .footer.dashboard {
        margin-top: 2rem;
        padding: 1rem;
        text-align: center;
    }

    .content {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .footer.dashboard .content {
        justify-content: center;
        padding: 0;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        color: var(--text);
    }

    .links {
        display: flex;
        gap: 1.5rem;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .links a {
        color: var(--text-muted);
        transition: color 0.15s;
    }

    .links a:hover {
        color: var(--text);
    }

    .copyright {
        margin: 0;
    }

    .footer.dashboard .links,
    .footer.dashboard .brand {
        display: none;
    }

    @media (max-width: 640px) {
        .content {
            flex-direction: column;
            text-align: center;
        }
    }
</style>