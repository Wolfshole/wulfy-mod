---
import Logo from "./Logo.astro";

const currentPath = Astro.url.pathname;

const navItems = [
    { href: "/dashboard", label: "Dashboard", icon: "▦" },
    { href: "/dashboard/welcome", label: "Willkommen", icon: "👋" },
    { href: "/dashboard/moderation", label: "Moderation", icon: "🛡️" },
    { href: "/dashboard/tickets", label: "Tickets", icon: "🎫" },
    { href: "/dashboard/logs", label: "Logs", icon: "📜" },
    { href: "/dashboard/settings", label: "Einstellungen", icon: "⚙️" },
];
---

<aside class="sidebar">
    <div class="brand-wrapper">
        <Logo size={38} />
    </div>

    <nav>
        {navItems.map(item => (
            <a
                href={item.href}
                class:list={["nav-item", { active: currentPath === item.href }]}
            >
                <span class="icon">{item.icon}</span>
                <span>{item.label}</span>
            </a>
        ))}
    </nav>

    <div class="footer">
    <a href="/api/auth/logout" class="nav-item">
        <span class="icon">↩</span>
        <span>Logout</span>
    </a>
</div>
</aside>

<style>
    .sidebar {
        width: 240px;
        height: 100vh;
        background: var(--bg-sidebar);
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        padding: 1rem 0;
        position: fixed;
        top: 0;
        left: 0;
    }

    .brand-wrapper {
        padding: 0 1.25rem 1.5rem;
    }

    nav {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        padding: 0 0.5rem;
    }

    .nav-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.65rem 0.85rem;
        border-radius: 8px;
        color: var(--text-muted);
        font-size: 0.95rem;
        transition: all 0.15s;
    }

    .nav-item:hover {
        background: var(--bg-hover);
        color: var(--text);
    }

    .nav-item.active {
        background: var(--accent);
        color: white;
        box-shadow: 0 0 12px var(--accent-glow);
    }

    .icon {
        width: 20px;
        text-align: center;
    }

    .footer {
        padding: 0 0.5rem;
        border-top: 1px solid var(--border);
        padding-top: 1rem;
    }
</style>