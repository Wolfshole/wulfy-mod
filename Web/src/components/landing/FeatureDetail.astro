---
interface Props {
    title: string;
    description: string;
    bullets?: string[];
    reverse?: boolean;
    emoji?: string;
}

const {
    title,
    description,
    bullets = [],
    reverse = false,
    emoji = "✨"
} = Astro.props;
---

<section class:list={["feature-detail", { reverse }]}>
    <div class="text">
        <h2>{title}</h2>
        <p>{description}</p>
        {bullets.length > 0 && (
            <ul>
                {bullets.map(b => <li>✓ {b}</li>)}
            </ul>
        )}
    </div>
    <div class="visual">
        <div class="mockup">{emoji}</div>
    </div>
</section>

<style>
    .feature-detail {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        align-items: center;
        max-width: 1100px;
        margin: 0 auto;
        padding: 4rem 2rem;
    }

    .feature-detail.reverse .text { order: 2; }
    .feature-detail.reverse .visual { order: 1; }

    .text h2 {
        font-size: 1.75rem;
        margin-bottom: 1rem;
    }

    .text p {
        color: var(--text-muted);
        line-height: 1.6;
        margin-bottom: 1.25rem;
    }

    .text ul {
        list-style: none;
        padding: 0;
    }

    .text li {
        margin-bottom: 0.5rem;
        color: var(--text);
        font-size: 0.95rem;
    }

    .mockup {
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.2), rgba(59, 130, 246, 0.1));
        border: 1px solid var(--border);
        border-radius: 16px;
        aspect-ratio: 4/3;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 5rem;
        box-shadow: 0 0 40px rgba(37, 99, 235, 0.15);
    }

    @media (max-width: 768px) {
        .feature-detail {
            grid-template-columns: 1fr;
        }
        .feature-detail.reverse .text,
        .feature-detail.reverse .visual {
            order: unset;
        }
    }
</style>